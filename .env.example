# =====================================================================
# Stype Server Configuration Template
# Copy this file to .env and adjust values for your environment.
# =====================================================================

# Server network binding
PORT=3000
HOST=0.0.0.0

# Public URL of the instance (required by SvelteKit adapter-node for CSRF validation)
# Examples: http://localhost:3000 or https://stype.example.com
ORIGIN=http://localhost:3000

# SQLite database file location
DATABASE_URL=data/stype.db

# ---------------------------------------------------------------------
# Initial Administrator Account
# Applied during initial database population on clean starts.
# Subsequent starts preserve whatever password has been set in the database.
# ---------------------------------------------------------------------
INITIAL_ADMIN_PASSWORD=admin123
INITIAL_ADMIN_EMAIL=admin@stype.local

# ---------------------------------------------------------------------
# SMTP Email Delivery (Optional)
# Required only if you want Stype to send password reset links and
# email confirmation tokens. If left blank, password reset requests
# will fail gracefully and email verification can be toggled by administrators.
# ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@stype.local
SMTP_SECURE=false
