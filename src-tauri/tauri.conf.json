{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Stype",
  "version": "0.0.1",
  "identifier": "com.stype.client",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:static"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Stype",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Lightweight typing practice application",
    "longDescription": "Lightweight typing practice application with offline local store and server synchronization.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24,
      "versionCode": 1,
      "debugApplicationIdSuffix": ".debug"
    },
    "iOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
