# Multi-stage Dockerfile for PocketBase SPA Server and Database

# Stage 1: Build static Single Page Application
FROM node:22-bookworm-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@9 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN STATIC_BUILD=1 pnpm build

# Stage 2: Production PocketBase runtime
FROM alpine:3.20 AS runner

ARG PB_VERSION=0.22.55
ARG TARGETARCH=amd64

WORKDIR /app

RUN apk add --no-cache \
    ca-certificates \
    unzip \
    wget

RUN wget -q "https://github.com/pocketbase/pocketbase/releases/download/v${PB_VERSION}/pocketbase_${PB_VERSION}_linux_${TARGETARCH}.zip" -O /tmp/pb.zip \
    && unzip /tmp/pb.zip -d /app/ \
    && rm /tmp/pb.zip \
    && chmod +x /app/pocketbase

COPY --from=builder /app/build ./pb_public
COPY pb_migrations ./pb_migrations

RUN mkdir -p /app/pb_data

EXPOSE 8090

VOLUME ["/app/pb_data"]

CMD ["/app/pocketbase", "serve", "--http=0.0.0.0:8090", "--dir=/app/pb_data", "--publicDir=/app/pb_public"]
